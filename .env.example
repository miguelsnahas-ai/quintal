# Supabase (project: familyos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (Settings -> API -> service_role). NUNCA prefixar com
# NEXT_PUBLIC_: só é usada no webhook do WhatsApp (rota de servidor sem
# sessão de usuário, que por isso precisa contornar as políticas de RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Groq — usado a partir da Sprint 4 (sugestão de evento e de resposta na
# triagem). API compatível com a da OpenAI; free tier sem cartão de
# crédito. Gere em console.groq.com -> API Keys.
GROQ_API_KEY=

# WhatsApp Business Cloud API
# VERIFY_TOKEN é um valor que você mesmo escolhe e cadastra também na
# configuração do webhook no painel da Meta (não vem de lá). APP_SECRET
# vem do painel do app na Meta (App settings -> Basic -> App secret).
# Ambos necessários desde a Sprint 2 (webhook inbound).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# ACCESS_TOKEN (token permanente de sistema, não o temporário de 24h) e
# PHONE_NUMBER_ID vêm do painel do app na Meta. Necessários a partir da
# Sprint 5 (envio de respostas). Lembrete: fora da janela de 24h desde a
# última mensagem do usuário, só templates pré-aprovados podem ser
# enviados — texto livre (o que este app envia) só funciona dentro dela.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcional: versão da Graph API (default no código: v21.0). Só defina se
# precisar sobrepor por causa de depreciação futura.
WHATSAPP_GRAPH_API_VERSION=
